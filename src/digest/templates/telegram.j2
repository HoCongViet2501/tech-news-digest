{# Telegram parse_mode=HTML: only b, i, a, code tags are used. #}
{% macro header(digest, t) %}
<b>{{ t.title }} · {{ digest.date.isoformat() }}</b>
{% if digest.stats.get("ai") == "unavailable" %}
<i>{{ t.ai_unavailable }}</i>
{% endif %}
{% endmacro %}

{% macro item(n, it, t) %}
{{ n }}. <a href="{{ it.url }}">{{ it.title | truncate_title }}</a>
<i>{{ it.source }} · {{ it.score }}{% if it.reason is not none %} · {{ it.relevance | score10 }}{% endif %}{% if it.also_on %} · {{ t.also_on }} {{ it.also_on | join(", ") }}{% endif %}</i>{% if it.discussion_url %} · <a href="{{ it.discussion_url }}">{{ t.discussion }}</a>{% endif +%}
{% if it.summary %}
{{ it.summary }}
{% endif %}
{% if it.why_it_matters %}
💡 {{ it.why_it_matters }}
{% endif %}
{% endmacro %}

{% macro radar_entry(e, t) %}
{% if e.kind == "vulnerability" %}
🛡 <a href="{{ e.url }}">{{ e.package }} {{ e.installed }}</a>{% if e.severity %} · <b>{{ e.severity }}</b>{% endif %}{% if e.version %} · {{ t.fixed_in }} {{ e.version }}{% endif +%}
{{ e.title | truncate_title }}
{% else %}
{{ "🚀" if e.kind == "major" else "💥" }} <a href="{{ e.url }}">{{ e.package }} {{ e.version }}</a> · {{ t[e.kind] }}{% if e.installed %} · {{ t.installed }} {{ e.installed }}{% endif +%}
{% if e.summary %}
{{ e.summary }}
{% endif %}
{% if e.action_required is not none %}
{{ ("⚠️ " ~ t.action_required) if e.action_required else ("✅ " ~ t.no_action) }}
{% endif %}
{% endif %}
{% endmacro %}
