{# Telegram parse_mode=HTML: only b, i, a, code tags are used. #}
{% macro header(digest, t) %}
<b>{{ t.title }} · {{ digest.date.isoformat() }}</b>
{% if digest.stats.get("ai") == "unavailable" %}
<i>{{ t.ai_unavailable }}</i>
{% endif %}
{% endmacro %}

{# web: base URL of the web app (no trailing slash) or "": then titles link to the article. #}
{% macro item(n, it, t, web="") %}
{{ n }}. <a href="{{ (web ~ "/items/" ~ it.id) if web else it.url }}">{{ it.title | truncate_title }}</a>
<i>{{ it.source }} · {{ it.score }}{% if it.reason is not none %} · {{ it.relevance | score10 }}{% endif %}{% if it.also_on %} · {{ t.also_on }} {{ it.also_on | join(", ") }}{% endif %}</i>{% if web %} · <a href="{{ it.url }}">{{ t.original }}</a>{% endif %}{% if it.discussion_url %} · <a href="{{ it.discussion_url }}">{{ t.discussion }}</a>{% endif +%}
{% if it.summary %}
{{ it.summary }}
{% endif %}
{% if it.why_it_matters %}
💡 {{ it.why_it_matters }}
{% endif %}
{% endmacro %}

