{% macro items(digest, t) %}
{% if digest and digest.radar %}
<section class="radar">
<h2>🛡 {{ t.radar }}</h2>
<ul>
{% for e in digest.radar %}
  <li>
{% if e.kind == "vulnerability" %}
    {{ severity_icon(e.severity) }} <b>{{ e.package }}</b> {{ e.installed }} · <a href="{{ e.url }}">{{ e.key }}</a>{% if e.severity %} · {{ e.severity }}{% endif %}<br>
    {{ e.title }}{% if e.fixed_in %} · {{ t.fixed_in }} {{ e.fixed_in }}{% endif +%}
{% else %}
    {{ "⬆️" if e.kind == "major" else "⚠️" }} <b>{{ e.package }}</b> {{ e.installed or "?" }} → <a href="{{ e.url }}">{{ e.version }}</a> · {{ t.major if e.kind == "major" else t.breaking }}
{% if e.summary %}
    <p class="summary">{{ e.summary }}</p>
{% endif %}
{% if e.action_required is not none %}
    <p class="why">{{ "❗ " ~ t.action_required if e.action_required else "✅ " ~ t.no_action }}</p>
{% endif %}
{% endif %}
{% if e.projects %}
    <span class="meta">{{ e.projects | repo_names }}</span>
{% endif %}
  </li>
{% endfor %}
</ul>
</section>
{% endif %}
{% if digest and digest.stats.get("ai") == "unavailable" %}
<p class="note">{{ t.ai_unavailable }}</p>
{% endif %}
{% if digest and digest.items %}
<ol class="items">
{% for it in digest.items %}
  <li>
    <a href="{{ it.url }}">{{ it.title }}</a><br>
    <span class="meta">{{ it.source }} · {{ it.score }}{% if it.reason is not none %} · {{ it.relevance | score10 }}{% endif %}{% if it.also_on %} · {{ t.also_on }} {{ it.also_on | join(", ") }}{% endif %}{% if it.discussion_url %} · <a href="{{ it.discussion_url }}">{{ t.discussion }}</a>{% endif %}</span>
{% if it.summary %}
    <p class="summary">{{ it.summary }}</p>
{% endif %}
{% if it.why_it_matters %}
    <p class="why">💡 {{ it.why_it_matters }}</p>
{% endif %}
  </li>
{% endfor %}
</ol>
{% else %}
<p>{{ t.empty }}</p>
{% endif %}
{% endmacro %}
