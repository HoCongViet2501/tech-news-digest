# Public Supabase settings for the web app (docs/PLAN.md §13 Deployment).
# Copy to .env.local for local development. Local values come from
# `corepack pnpm exec supabase status` (API_URL and PUBLISHABLE_KEY).
# Production values are set in Vercel. Never put a secret / service-role key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Local e2e only: shows an email/password form on /sign-in (the hosted project has no
# Email provider). Ignored unless NEXT_PUBLIC_SUPABASE_URL is localhost/127.0.0.1.
# `pnpm e2e` sets it for the server it starts.
# NEXT_PUBLIC_DEV_PASSWORD_LOGIN=1
